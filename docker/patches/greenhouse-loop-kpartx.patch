+	rm -f "/host${TESTLOOP}p1" 2>/dev/null || true
+fi
+kpartx -d "${TESTLOOP}" >/dev/null 2>&1 || true
+losetup -d $TESTLOOP
+if [[ $LOSETUP_STATUS != *"/host/dev"* && $LOSETUP_STATUS != *"/dev/mapper"* ]]; then

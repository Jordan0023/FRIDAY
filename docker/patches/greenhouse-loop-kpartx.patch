+if [[ -z "${LOSETUP_STATUS}" ]]; then
+	MAPPER_DEV="/dev/mapper/$(basename ${TESTLOOP})p1"
+	kpartx -av "${TESTLOOP}" >/dev/null 2>&1 || true

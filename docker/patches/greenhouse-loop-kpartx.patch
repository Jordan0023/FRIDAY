@@ -29,10 +29,23 @@ fi
 echo "Testing losetup"
 losetup -Pf /testimage.raw
 TESTLOOP=`losetup | grep testimage.raw | awk '{print $1}'`
-LOSETUP_STATUS=`ls /host${TESTLOOP}p1`
-losetup -d $TESTLOOP

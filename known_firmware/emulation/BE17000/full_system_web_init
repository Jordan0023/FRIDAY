#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
LD_PRELOAD=/lib/be17000_web_shim.so
export LD_PRELOAD

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /var/run /var/log/lighttpd /var/tmp /data /mnt/nvram
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp

insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/virtio/virtio_mmio.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/net/core/failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/net_failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/virtio_net.ko

ip link set eth0 down
ip link set eth0 name br0
ifconfig br0 10.0.2.15 netmask 255.255.255.0 up
ifconfig lo 127.0.0.1 up

cat >/tmp/net-cgi.conf <<'EOF'
nc_upg_mod ""
nc_hw_id ""
nc_mode_1 "54"
nc_mode_2 "286"
nc_mode_3 "600"
nc_an_mode_1 "286"
nc_an_mode_2 "573"
nc_an_mode_3 "1200"
nc_device_name_length "63"
nc_support_router_protection "1"
EOF

echo "FRIDAY_BE17000_WEB_BOOT=1"
echo "KERNEL=$(uname -a)"

/bin/smd -v 2 >/dev/console 2>&1 &
SMD_PID=$!
attempt=0
while test "$attempt" -lt 30; do
    test -S /var/smd_messaging_server_addr && break
    sleep 1
    attempt=$((attempt + 1))
done
echo "SMD_PID=$SMD_PID"
echo "SMD_ALIVE=$(kill -0 "$SMD_PID" 2>/dev/null && echo yes || echo no)"
echo "SMD_SOCKET=$(test -S /var/smd_messaging_server_addr && echo ready || echo missing)"

cat >/tmp/lighttpd-web-lab.conf <<'EOF'
server.modules = ( "mod_cgi", "mod_rewrite" )
server.document-root = "/www"
server.upload-dirs = ( "/tmp" )
server.errorlog = "/dev/console"
server.pid-file = "/var/run/lighttpd.pid"
server.username = "root"
server.groupname = "root"
server.port = 80
server.bind = "0.0.0.0"
index-file.names = ( "index.htm", "index.html" )
cgi.assign = ( "" => "/usr/sbin/net-cgi" )
cgi.x-sendfile = "enable"
cgi.x-sendfile-docroot = ( "/www/", "/tmp/" )
url.rewrite-once = ( "^.*/soap/server_sa/?$" => "/soapapi" )
EOF

touch /www/soapapi
/usr/sbin/lighttpd -D -f /tmp/lighttpd-web-lab.conf >/dev/console 2>&1 &
LIGHTTPD_PID=$!
attempt=0
while test "$attempt" -lt 45; do
    grep -q ':0050 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && break
    sleep 1
    attempt=$((attempt + 1))
done
echo "LIGHTTPD_PID=$LIGHTTPD_PID"
echo "LIGHTTPD_ALIVE=$(kill -0 "$LIGHTTPD_PID" 2>/dev/null && echo yes || echo no)"
echo "HTTP_LISTENING=$(grep -q ':0050 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && echo yes || echo no)"
echo "FRIDAY_BE17000_WEB_READY=1"

while true; do
    kill -0 "$SMD_PID" 2>/dev/null || echo "SMD_EXITED=1"
    kill -0 "$LIGHTTPD_PID" 2>/dev/null || echo "LIGHTTPD_EXITED=1"
    sleep 2
done

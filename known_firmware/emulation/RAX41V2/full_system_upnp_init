#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
LD_PRELOAD="/lib/rax54s_device_shim.so /lib/rax54s_emulation_shim.so"
export LD_PRELOAD

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /var/run /var/log /var/tmp /data /mnt/nvram
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
touch /dev/acos_nat_cli /dev/spiv6
for number in 1 3 4 14 15; do
    touch "/dev/mtd$number"
done

insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/virtio/virtio_mmio.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/net/core/failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/net_failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/virtio_net.ko

ip link set eth0 down
ip link set eth0 name br0
ifconfig br0 10.0.2.15 netmask 255.255.255.0 up
ifconfig lo 127.0.0.1 up
route add default gw 10.0.2.2

/bin/acos_nvram init
/bin/acos_nvram set lan_ifname=br0
/bin/acos_nvram set lan_ipaddr=10.0.2.15
/bin/acos_nvram set lan_netmask=255.255.255.0
/bin/acos_nvram set wan_ifname=br0
/bin/acos_nvram set wan_ipaddr=10.0.2.15
/bin/acos_nvram set upnp_enable=1
/bin/acos_nvram set upnp_turn_on=1

echo "FRIDAY_RAX41V2_UPNP_BOOT=1"
/bin/smd -v 2 >/dev/console 2>&1 &
attempt=0
while test "$attempt" -lt 30; do
    test -S /var/smd_messaging_server_addr && break
    sleep 1
    attempt=$((attempt + 1))
done
echo "SMD_SOCKET=$(test -S /var/smd_messaging_server_addr && echo ready || echo missing)"

/bin/strace -f -tt -s 160 -o /tmp/upnpd.strace \
    /usr/sbin/upnpd >/dev/console 2>&1 &
sleep 12
UPNPD_PID="$(pidof upnpd | awk '{print $1}')"
echo "UPNPD_PID=$UPNPD_PID"
echo "UPNPD_ALIVE=$(test -n "$UPNPD_PID" && kill -0 "$UPNPD_PID" 2>/dev/null && echo yes || echo no)"
echo "UPNPD_TCP_BEGIN"
cat /proc/net/tcp /proc/net/tcp6
echo "UPNPD_TCP_END"
echo "UPNPD_UDP_BEGIN"
cat /proc/net/udp /proc/net/udp6
echo "UPNPD_UDP_END"
echo "UPNPD_STRACE_TAIL_BEGIN"
tail -n 160 /tmp/upnpd.strace 2>/dev/null
echo "UPNPD_STRACE_TAIL_END"
echo "FRIDAY_RAX41V2_UPNP_READY=1"

EXIT_REPORTED=no
while true; do
    CURRENT_PID="$(pidof upnpd | awk '{print $1}')"
    if test -z "$CURRENT_PID"; then
        if test "$EXIT_REPORTED" = no; then
            echo "UPNPD_EXITED=1"
            tail -n 240 /tmp/upnpd.strace 2>/dev/null
            EXIT_REPORTED=yes
        fi
    else
        echo "UPNPD_HEALTH_PID=$CURRENT_PID $(grep '^VmRSS:' /proc/"$CURRENT_PID"/status 2>/dev/null)"
    fi
    sleep 5
done

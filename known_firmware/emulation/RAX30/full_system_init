#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
LD_PRELOAD=/lib/rax30_emulation_shim.so
export LD_PRELOAD

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /var/run /var/log /var/tmp /data /mnt/nvram
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp

insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/virtio/virtio_mmio.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/net/core/failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/net_failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/virtio_net.ko

ip link set eth0 down
ip link set eth0 name br0
ifconfig br0 10.0.2.15 netmask 255.255.255.0 up
ifconfig lo 127.0.0.1 up
route add default gw 10.0.2.2

echo "FRIDAY_RAX30_FULL_SYSTEM_BOOT=1"
echo "KERNEL=$(uname -a)"
echo "INIT_STATUS=$(grep '^Uid:' /proc/1/status)"

/bin/smd -v 2 >/dev/console 2>&1 &
SMD_PID=$!
attempt=0
while test "$attempt" -lt 30; do
    test -S /var/smd_messaging_server_addr && break
    sleep 1
    attempt=$((attempt + 1))
done
echo "SMD_PID=$SMD_PID"
echo "SMD_SOCKET=$(test -S /var/smd_messaging_server_addr && echo ready || echo missing)"

/bin/soap_serverd -d 0 -n 1 -l 1 >/dev/console 2>&1 &
attempt=0
while test "$attempt" -lt 60; do
    grep -q ':1388 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && break
    sleep 1
    attempt=$((attempt + 1))
done
SOAP_PID="$(pidof soap_serverd | awk '{print $1}')"
echo "SOAP_PID=$SOAP_PID"
echo "SOAP_ALIVE=$(test -n "$SOAP_PID" && kill -0 "$SOAP_PID" 2>/dev/null && echo yes || echo no)"
echo "SOAP_LISTENING=$(grep -q ':1388 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && echo yes || echo no)"
echo "TCP_TABLE_BEGIN"
cat /proc/net/tcp
cat /proc/net/tcp6
echo "TCP_TABLE_END"
echo "FRIDAY_RAX30_READY=1"

health_tick=0
while true; do
    CURRENT_SOAP_PID="$(pidof soap_serverd | awk '{print $1}')"
    if test -z "$CURRENT_SOAP_PID"; then
        echo "SOAP_EXITED=1"
    fi
    health_tick=$((health_tick + 1))
    if test "$health_tick" -ge 5; then
        echo "SOAP_HEALTH_PID=$CURRENT_SOAP_PID $(grep '^VmRSS:' /proc/"$CURRENT_SOAP_PID"/status 2>/dev/null)"
        health_tick=0
    fi
    sleep 2
done

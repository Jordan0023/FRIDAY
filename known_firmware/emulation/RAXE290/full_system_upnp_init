#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
LD_PRELOAD=/lib/rax30_emulation_shim.so
export LD_PRELOAD

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /var/run /var/log /var/tmp /data /mnt/nvram
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp

insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/virtio/virtio_mmio.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/net/core/failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/net_failover.ko
insmod /lib/modules/6.1.0-50-armmp/kernel/drivers/net/virtio_net.ko

ip link set eth0 down
ip link set eth0 name br0
ifconfig br0 10.0.2.15 netmask 255.255.255.0 up
ifconfig lo 127.0.0.1 up
route add default gw 10.0.2.2
WAN_IF=br0
if ip link show eth1 >/dev/null 2>&1; then
    ifconfig eth1 198.51.100.15 netmask 255.255.255.0 up
    WAN_IF=eth1
fi
echo "UPNP_LAN_IF=br0"
echo "UPNP_WAN_IF=$WAN_IF"
echo "FRIDAY_RAXE290_UPNP_BOOT=1"

/bin/smd -v 2 >/dev/console 2>&1 &
attempt=0
while test "$attempt" -lt 30; do
    test -S /var/smd_messaging_server_addr && break
    sleep 1
    attempt=$((attempt + 1))
done
echo "SMD_SOCKET=$(test -S /var/smd_messaging_server_addr && echo ready || echo missing)"

/bin/soap_serverd -d 0 -p 5000 >/dev/console 2>&1 &
attempt=0
while test "$attempt" -lt 30; do
    SHMID="$(awk 'NR == 2 {print $2}' /proc/sysvipc/shm)"
    test -n "$SHMID" && break
    sleep 1
    attempt=$((attempt + 1))
done
kill "$(pidof soap_serverd | awk '{print $1}')" 2>/dev/null
sleep 1
echo "UPNP_SHMID=$SHMID"

/bin/upnp -L br0 -W "$WAN_IF" -W2 "$WAN_IF" -m "$SHMID" >/dev/console 2>&1 &
sleep 8
UPNP_PID="$(pidof upnp | awk '{print $1}')"
echo "UPNP_PID=$UPNP_PID"
echo "UPNP_ALIVE=$(test -n "$UPNP_PID" && kill -0 "$UPNP_PID" 2>/dev/null && echo yes || echo no)"
echo "UPNP_TCP_BEGIN"
cat /proc/net/tcp
cat /proc/net/tcp6
echo "UPNP_TCP_END"
echo "UPNP_UDP_BEGIN"
cat /proc/net/udp
cat /proc/net/udp6
echo "UPNP_UDP_END"
echo "UPNP_DISCOVERY_BEGIN"
DISCOVERY="$(/bin/ssdp_guest_probe)"
echo "$DISCOVERY"
echo "UPNP_DISCOVERY_END"
echo "FRIDAY_RAX30_UPNP_READY=1"
echo "FRIDAY_RAXE290_UPNP_READY=1"

PROBE_MODE="$(sed -n 's/.*friday_probe=\([^ ]*\).*/\1/p' /proc/cmdline)"
if test "$PROBE_MODE" = candidate || test "$PROBE_MODE" = control; then
    UUID="$(echo "$DISCOVERY" | sed -n 's|.*Location: http://[^/]*/dyndev/\(uuid:[0-9a-f-]*\).*|\1|p')"
    if test "$PROBE_MODE" = candidate; then
        CALLBACK="http://10.0.2.2/FRIDAY_RAX30_PROBE_7b6f2aAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    else
        CALLBACK="http://10.0.2.2:9/event"
    fi
    REQUEST="SUBSCRIBE /$UUID/Layer3Forwarding:1 HTTP/1.1\r
Host: 10.0.2.15:56688\r
CALLBACK: <$CALLBACK>\r
NT: upnp:event\r
Content-Length: 0\r
Connection: close\r
\r
"
    echo "FRIDAY_RAXE290_PROBE_MODE=$PROBE_MODE"
    echo "FRIDAY_RAXE290_PROBE_UUID=$UUID"
    printf "$REQUEST" | nc -w 3 127.0.0.1 56688 >/dev/console 2>&1
    sleep 5
    POST_PID="$(pidof upnp | awk '{print $1}')"
    echo "FRIDAY_RAXE290_POST_PROBE_PID=$POST_PID"
    echo "FRIDAY_RAXE290_POST_PROBE_ALIVE=$(test -n "$POST_PID" && kill -0 "$POST_PID" 2>/dev/null && echo yes || echo no)"
fi

while kill -0 "$UPNP_PID" 2>/dev/null; do
    CURRENT_UPNP_PID="$(pidof upnp | awk '{print $1}')"
    if test -n "$CURRENT_UPNP_PID"; then
        echo "UPNP_HEALTH_PID=$CURRENT_UPNP_PID $(grep '^VmRSS:' /proc/"$CURRENT_UPNP_PID"/status 2>/dev/null)"
    fi
    sleep 5
done
wait "$UPNP_PID"
UPNP_WAIT_STATUS=$?
echo "UPNP_WAIT_STATUS=$UPNP_WAIT_STATUS"
echo "UPNP_EXITED=1"
while true; do sleep 5; done

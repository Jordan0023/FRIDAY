#!/bin/sh

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export LD_LIBRARY_PATH=/lib:/usr/lib
BB=/greenhouse/busybox

echo "FRIDAY_GTBE98_STAGE1=1"
$BB mount -t proc proc /proc 2>/dev/null
$BB mount -t sysfs sysfs /sys 2>/dev/null
$BB mount -t devtmpfs devtmpfs /dev 2>/dev/null
$BB mkdir -p /dev/pts /run /tmp /var/run /var/log /data /jffs /mnt/defaults
$BB mkdir -p /run/proc-nvram /run/proc-environment
$BB mount -t devpts devpts /dev/pts 2>/dev/null

echo "GT-BE98PRO" > /run/proc-nvram/boardid
echo "8" > /run/proc-nvram/wl_nand_manufacturer
echo "20:CF:30:00:00:00" > /run/proc-nvram/BaseMacAddr
: > /run/proc-nvram/set
echo "GT-BE98PRO" > /run/proc-environment/boardid
echo "GT-BE98PRO.nvm" > /run/proc-environment/wlnvram

for MODULE in virtio_net bridge x_tables nf_conntrack nf_nat ip_tables iptable_filter iptable_nat; do
    modprobe "$MODULE" 2>/dev/null &&
        echo "FRIDAY_GTBE98_MODULE=$MODULE:loaded" ||
        echo "FRIDAY_GTBE98_MODULE=$MODULE:failed"
done

ip link set lo up
ip link set eth0 up
ip link set eth1 up
ip link add br0 type bridge 2>/dev/null
ip link set eth1 master br0 2>/dev/null
ip addr add 192.0.2.2/24 dev eth0 2>/dev/null
ip addr add 10.0.2.15/24 dev br0 2>/dev/null
ip link set br0 up

echo "FRIDAY_GTBE98_INTERFACES_BEGIN"
ip -4 addr show
echo "FRIDAY_GTBE98_INTERFACES_END"
echo "FRIDAY_GTBE98_STOCK_INIT_EXEC=1"

# Replace stage 1 so the original ASUS rc multicall is the guest's PID 1.
export LD_PRELOAD=/lib/libproc-nvram-compat.so
exec /sbin/init

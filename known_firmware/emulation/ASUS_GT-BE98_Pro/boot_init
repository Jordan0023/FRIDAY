#!/bin/busybox sh

/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /proc /sys /newroot
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox insmod /virtio_blk.ko

COUNT=0
while [ ! -b /dev/vda ] && [ "$COUNT" -lt 100 ]; do
    /bin/busybox sleep 1
    COUNT=$((COUNT + 1))
done

if ! /bin/busybox mount -t ext4 -o rw /dev/vda /newroot; then
    echo "FRIDAY_GTBE98_ROOT_MOUNT_FAILED=1"
    exec /bin/busybox sh
fi

exec /bin/busybox switch_root /newroot /init

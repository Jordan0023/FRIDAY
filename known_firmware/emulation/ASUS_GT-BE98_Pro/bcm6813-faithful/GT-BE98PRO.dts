		gpioc {
			compatible = "brcm,bca-gpio";
			gpio-controller;
			#gpio-cells = <0x02>;
			reg = <0x00 0x500 0x00 0x20 0x00 0x520 0x00 0x20>;
			reg-names = "gpio-dir\0gpio-data";
			ngpios = <0x50>;
			gpio-ranges = <0x20 0x00 0x00 0x50>;
			phandle = <0x0e>;
		};

		bca_extintr0 {
			compatible = "brcm,bca-extintr";
			num_ext_intr = <0x08>;
			reg = <0x00 0x04 0x00 0x48>;
			external_interrupts = <0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36>;
		};

		serial0 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "arm,pl011\0arm,primecell";
			reg = <0x00 0x12000 0x00 0x1000>;
			interrupts = <0x00 0x20 0x04>;
			clocks = <0x21 0x21>;
			clock = <0x2faf080>;
			clock-names = "uartclk\0apb_pclk";
			status = "okay";
		};

		serial3 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "arm,pl011\0arm,primecell";
			reg = <0x00 0x15000 0x00 0x1000>;
			interrupts = <0x00 0x21 0x04>;
			clocks = <0x21 0x21>;
			clock = <0x2faf080>;
			clock-names = "uartclk\0apb_pclk";
			status = "disabled";
		};

		hs_serial0 {
			compatible = "brcm,bcm63xx-hs-uart";
			reg-names = "hs_uart_base";
			reg = <0x00 0x10400 0x00 0x1e0>;
			interrupts = <0x00 0x22 0x04>;
			clocks = <0x22>;
			u-boot,dm-pre-reloc;
			status = "disabled";
		};

		spi {
			pinctrl-0 = <0x23>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "brcm,bcmbca-hsspi";
			reg-names = "hsspi\0spim-ctrl";
			reg = <0x00 0x1000 0x00 0x600 0x00 0x2610 0x00 0x04>;
			clocks = <0x24 0x24>;
			clock-names = "hsspi\0pll";
			spi-max-frequency = <0x5f5e100>;
			num-cs = <0x08>;
			status = "okay";

			spi-nand@0 {
				pinctrl-0 = <0x25>;
				pinctrl-names = "default";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "spi-nand";
				reg-names = "spi-nand";
				reg = <0x00>;
				spi-max-frequency = <0x5f5e100>;
				spi-tx-bus-width = <0x02>;
				spi-rx-bus-width = <0x02>;
				u-boot,dm-pre-reloc;
				status = "okay";
			};

			spi-nor@0 {
				pinctrl-0 = <0x25>;
				pinctrl-names = "default";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "jedec,spi-nor";
				reg = <0x00>;
				spi-max-frequency = <0x2faf080>;
				label = "spi-nor.0";
				u-boot,dm-pre-reloc;
				status = "disabled";

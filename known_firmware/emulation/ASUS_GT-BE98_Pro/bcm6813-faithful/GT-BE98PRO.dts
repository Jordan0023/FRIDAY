/dts-v1/;

/memreserve/	0x0000000000000000 0x0000000000100000;
/ {
	model = "Broadcom-v8A";
	compatible = "brcm,brcm-v8A";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
		cpu_off = <0x01>;
		cpu_on = <0x02>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			next-level-cache = <0x02>;
			phandle = <0x03>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			next-level-cache = <0x02>;
			phandle = <0x04>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x02>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			next-level-cache = <0x02>;
			phandle = <0x05>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00 0x03>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			next-level-cache = <0x02>;
			phandle = <0x06>;
		};

		l2-cache0 {
			compatible = "cache";
			phandle = <0x02>;
		};
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x8000000>;
	};

	interrupt-controller@81000000 {
		compatible = "arm,cortex-a15-gic\0arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0x81001000 0x00 0x1000 0x00 0x81002000 0x00 0x2000>;
		phandle = <0x01>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0x07 0x04 0x00 0x08 0x04 0x00 0x09 0x04 0x00 0x0a 0x04>;
		interrupt-affinity = <0x03 0x04 0x05 0x06>;
	};

	brcm-legacy {
		compatible = "brcm,brcm-legacy";
	};

	clocks {
		compatible = "simple-bus";
		u-boot,dm-pre-reloc;

		periph-osc {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xbebc200>;
			u-boot,dm-pre-reloc;
			phandle = <0x22>;
		};

		refclk50mhz {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x2faf080>;
			phandle = <0x21>;
		};

		hsspi-pll {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xbebc200>;
			u-boot,dm-pre-reloc;
			phandle = <0x24>;
		};

		oscillator {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0xbebc200>;
			phandle = <0x07>;
		};

		i2stxclk@0x80158000 {
			#clock-cells = <0x00>;
			compatible = "brcm,i2s-tx-clock";
			clocks = <0x07>;
			clk-mclk-syscon = <0x08>;
			clock-tx-output-names = "i2s_tx_clk";
		};

		i2srxclk@0x80158000 {
			#clock-cells = <0x00>;
			compatible = "brcm,i2s-rx-clock";
			clocks = <0x07>;
			clk-mclk-syscon = <0x08>;
			clock-rx-output-names = "i2s_rx_clk";
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		dt_reserved_cma {
			compatible = "shared-dma-pool";
			reusable;
			align = <0x100000>;
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x09>;
		};
	};

	plat_rsvmem_cached_device {
		compatible = "brcm,plat-rsvmem";
		dma-coherent;
		memory-region = <0x09>;

		dt_reserved_bufmem {
			rsvd-size = <0x8000000>;
		};

		dt_reserved_rnrmem {
			rsvd-size = <0xc00000>;
		};

		dt_reserved_ddosmem {
			rsvd-size = <0x00>;
		};
	};

	plat_rsvmem_uncached_device {
		compatible = "brcm,plat-rsvmem";
		memory-region = <0x09>;

		dt_reserved_dhd0 {
			rsvd-size = <0x00>;
		};

		dt_reserved_dhd1 {
			rsvd-size = <0x00>;
		};

		dt_reserved_dhd2 {
			rsvd-size = <0x00>;
		};

		dt_reserved_dhd3 {
			rsvd-size = <0x00>;
		};
	};

	memory_controller {
		compatible = "brcm,bcm-memc";
		reg-names = "memc-int-clear-reg\0memc-int-mask-clear-reg\0phyctl_idle_pad_ctl\0phyctl_idle_pad_en0\0phyctl_idle_pad_en1\0phybl0_idle_pad_ctl\0phybl1_idle_pad_ctl\0phybl0_clock_idle\0phybl1_clock_idle\0auto_self_refresh\0glb_gcfg";
		reg = <0x00 0x80040e28 0x00 0x04 0x00 0x80040e34 0x00 0x04 0x00 0x80060200 0x00 0x04 0x00 0x80060204 0x00 0x04 0x00 0x80060208 0x00 0x04 0x00 0x8006071c 0x00 0x04 0x00 0x8006091c 0x00 0x04 0x00 0x8006073c 0x00 0x04 0x00 0x8006093c 0x00 0x04 0x00 0x8004000c 0x00 0x04 0x00 0x80040008 0x00 0x04>;
		interrupts = <0x00 0x13 0x04>;
		status = "okay";
		memcfg = <0x161635>;
	};

	aliases {
		serial0 = "/periph/serial0";
		serial3 = "/periph/serial3";
		spi1 = "/periph/spi";
		spinand0 = "/periph/spi/spi-nand@0";
		spinor0 = "/periph/spi/spi-nor@0";
		nand0 = "/periph/nand";
		hs_serial0 = "/periph/hs_serial0";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "coherent_pool=4M cpuidle_sysfs_switch pci=pcie_bus_safe console=ttyAMA0,115200  rootwait rng_core.default_quality=1024";
	};

	wantype_detect {
		compatible = "brcm,wantypedetect";
		status = "okay";
		reg-names = "gpon_general_config\0epon_top\0epon_lif\0epon_xpcsr\0ngpon_rxgen";
		reg = <0x00 0x828e1000 0x00 0x10 0x00 0x828c0000 0x00 0x1c 0x00 0x828c1800 0x00 0x110 0x00 0x828c3000 0x00 0x124 0x00 0x828e4000 0x00 0x80>;
	};

	misc_io {
		compatible = "brcm,misc-io";
		misc-periph-int-ctrl = <0x00 0xff80260c 0x00 0x04>;
		sdio-emmc-clk-sel-mask = <0x10000>;
		misc-emmc-cktap-ctrl = <0x00 0xff80264c 0x00 0x18>;
		misc-periph-chip-id-rev = <0x00 0xff800000 0x00 0x04>;
		misc-periph-chip-id-mask = <0xfffff000>;
		misc-periph-chip-id-shift = <0x0c>;
		misc-periph-chip-rev-mask = <0xfff>;
	};

	pmc {
		compatible = "brcm,bca-pmc-3-2";
		reg = <0x00 0xffb01018 0x00 0x5080 0x00 0xffb20000 0x00 0x240 0x00 0xffb00400 0x00 0x5d0 0x00 0xffbc0000 0x00 0x4000 0x00 0xffb80000 0x00 0x1000>;
		reg-names = "pmc\0procmon\0maestro\0itcm\0dtcm";
		interrupt-names = "pmc-temp-irq";
		interrupts = <0x00 0x1d 0x04>;
	};

	cci {
		compatible = "arm,cci-500";
		reg = <0x00 0x81100000 0x00 0x8000>;
		slave-intf-cpu = <0x01>;
	};

	pciec {
		compatible = "brcm,bcm-pcie";
		device_type = "cpci";
		brcm,pllclkid = <0x1110>;
	};

	pcie@3 {
		compatible = "brcm,bcm963xx-pcie";
		device_type = "pci";
		reg = <0x00 0x800b0000 0x00 0xb000>;
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		ranges = <0x2000000 0x00 0xa0000000 0x00 0xa0000000 0x00 0x20000000>;
		interrupt-names = "intr";
		interrupts = <0x00 0x47 0x04>;
		#interrupt-cells = <0x01>;
		interrupt-map-mask = <0x00 0x00 0x00 0x00>;
		interrupt-map = <0x00 0x00 0x00 0x00 0x01 0x00 0x47 0x04>;
		brcm,coreid = <0x03>;
		linux,pci-domain = <0x03>;
		status = "okay";
		brcm,strap-pcie-rc-mode = <0x06 0x01>;
		brcm,supply-names = "vreg-pcie3";
	};

	spu_pdc {
		compatible = "brcm,spu-pdc";
		reg = <0x00 0x83800000 0x00 0x400000>;
		interrupts = <0x00 0x3a 0x04>;
		brcm,num_chan = <0x04>;
		status = "disabled";
	};

	spu_flexrm {
		compatible = "brcm,spu-flexrm";
		reg = <0x00 0x83800000 0x00 0x400000>;
		interrupts = <0x00 0x3a 0x04 0x00 0x3b 0x04 0x00 0x3c 0x04 0x00 0x3d 0x04>;
		brcm,num_chan = <0x04>;
		brcm,num_ae = <0x02>;
		status = "okay";
		dma-coherent;
	};

	spu_crypto {
		compatible = "brcm,spu-crypto";
		reg = <0x00 0x83800000 0x00 0x400000>;
		brcm,num_spu = <0x01>;
		brcm,spu_type = <0x02>;
		status = "okay";
	};

	usb_ctrl {
		compatible = "brcm,bcmbca-usb-ctrl";
		reg-names = "usb-ctrl";
		reg = <0x00 0x800cf200 0x00 0x128>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0x0a 0x0b>;
		xhci-enable;
	};

	usb0_xhci {
		compatible = "brcm,bcmbca-xhci";
		reg-names = "usb-xhci\0xhci-gbl";
		reg = <0x00 0x800c0000 0x00 0x484 0x00 0x800cc100 0x00 0x544>;
		interrupts = <0x00 0x49 0x04>;
		usb3-lpm-capable;
		status = "okay";
		xhci-no-companion;
	};

	serdes {
		compatible = "brcm,serdes1";
		reg = <0x00 0x837ff500 0x00 0x300>;
	};

	swblks {
		compatible = "brcm,swblks";
		reg-names = "bcast-ctrl\0qphy-ctrl";
		reg = <0x00 0x837ff000 0x00 0x04 0x00 0x837ff014 0x00 0x04>;
		phy_base = <0x01>;
	};

	xport {
		compatible = "brcm,xport";
		reg = <0x00 0x837f0000 0x00 0x8000 0x00 0x828b2000 0x00 0x1000 0x00 0x837ff1f8 0x00 0x04>;
	};

	unimac {
		compatible = "brcm,unimac3";
		reg = <0x00 0x828a8000 0x00 0x5000 0x00 0x828b0000 0x00 0x1400>;
		conf_offset = <0x1000>;
		mib_offset = <0x400>;
		top_offset = <0x400>;
	};

	xlmac {
		compatible = "brcm,xlmac1";
		reg = <0x00 0x828b2000 0x00 0x680 0x00 0x82890000 0x00 0x6b88>;
		xlmac_offset = <0x200>;
		bbh_tx_offset = <0x2000>;
	};

	ethphytop {
		compatible = "brcm,eth-phy-top";
		reg = <0x00 0x837ff000 0x00 0x1000>;
		xphy0-addr = <0x09>;
		status = "okay";
		xphy0-enabled;
	};

	egphy {
		compatible = "brcm,egphy";
		reg = <0x00 0x837ff00c 0x00 0x20>;
	};

	mdiosf2 {
		compatible = "brcm,mdio-sf2";
		reg = <0x00 0x837ffd00 0x00 0x10 0x00 0xff85a024 0x00 0x04>;
	};

	mpm {
		compatible = "brcm,mpm";
		reg = <0x00 0x80020000 0x00 0x4000>;
	};

	mpcs {
		compatible = "brcm,mpcs";
		reg = <0x00 0x828c4000 0x00 0x100>;
	};

	gpon_drv {
		compatible = "brcm,gpon-drv";
		reg = <0x00 0x828e0000 0x00 0x4000>;
		interrupts = <0x00 0x8d 0x04 0x00 0x8c 0x04>;
		interrupt-names = "gpon_rx\0gpon_tx";
	};

	ngpon_drv {
		compatible = "brcm,ngpon-drv";
		reg = <0x00 0x828e4000 0x00 0x1c000>;
		interrupts = <0x00 0x81 0x04 0x00 0x85 0x04 0x00 0x84 0x04 0x00 0x83 0x04>;
		interrupt-names = "ngpon_rx\0ngpon_tx0\0ngpon_tx1\0ngpon_tx2";
	};

	wan_serdes {
		compatible = "brcm,pon-drv";
		status = "disabled";
		reg = <0x00 0x828c4000 0x00 0x1c000>;
	};

	epon_drv {
		compatible = "brcm,epon-drv";
		reg = <0x00 0x828c0000 0x00 0x4000>;
	};

	rdpa_drv {
		compatible = "brcm,rdpa";
		reg = <0x00 0x82000000 0x00 0xcaf004>;
		interrupts = <0x00 0x6b 0x04 0x00 0x4b 0x04 0x00 0x4c 0x04 0x00 0x4d 0x04 0x00 0x4e 0x04 0x00 0x4f 0x04 0x00 0x50 0x04 0x00 0x51 0x04 0x00 0x52 0x04 0x00 0x53 0x04 0x00 0x54 0x04 0x00 0x55 0x04 0x00 0x56 0x04 0x00 0x57 0x04 0x00 0x58 0x04 0x00 0x59 0x04 0x00 0x5a 0x04 0x00 0x5b 0x04 0x00 0x5c 0x04 0x00 0x5d 0x04 0x00 0x5e 0x04 0x00 0x5f 0x04 0x00 0x60 0x04 0x00 0x61 0x04 0x00 0x62 0x04 0x00 0x63 0x04 0x00 0x64 0x04 0x00 0x65 0x04 0x00 0x66 0x04 0x00 0x67 0x04 0x00 0x68 0x04 0x00 0x69 0x04 0x00 0x6a 0x04>;
		interrupt-names = "fpm\0queue0\0queue1\0queue2\0queue3\0queue4\0queue5\0queue6\0queue7\0queue8\0queue9\0queue10\0queue11\0queue12\0queue13\0queue14\0queue15\0queue16\0queue17\0queue18\0queue19\0queue20\0queue21\0queue22\0queue23\0queue24\0queue25\0queue26\0queue27\0queue28\0queue29\0queue30\0queue31";
	};

	xrdp {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0x82000000 0x00 0xcd0000 0x01 0x00 0x00 0xff800000 0x00 0x62000>;

		mdio {
			compatible = "simple-bus";
			bus-type = "DSL_ETHSW";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			phy_gphy0 {
				compatible = "brcm,bcaphy";
				phy-type = "EGPHY";
				reg = <0x01>;
				status = "disabled";
				phandle = <0x10>;
			};

			phy_gphy1 {
				compatible = "brcm,bcaphy";
				phy-type = "EGPHY";
				reg = <0x02>;
				status = "okay";
				phandle = <0x11>;
			};

			phy_gphy2 {
				compatible = "brcm,bcaphy";
				phy-type = "EGPHY";
				reg = <0x03>;
				status = "disabled";
				phandle = <0x12>;
			};

			phy_gphy3 {
				compatible = "brcm,bcaphy";
				phy-type = "EGPHY";
				reg = <0x04>;
				status = "disabled";
				phandle = <0x13>;
			};

			phy_xphy {
				compatible = "brcm,bcaphy";
				phy-type = "EXT3";
				reg = <0x09>;
				status = "okay";
				pinctrl-names = "default";
				pinctrl-0 = <0x0c 0x0d>;
				phandle = <0x15>;
			};

			phy_cascade0 {
				compatible = "brcm,bcaphy";
				phy-type = "EXT3";
				reg = <0x15>;
				status = "disabled";
				phy-external;
			};

			phy_serdes0 {
				compatible = "brcm,bcaphy";
				phy-type = "10GAE";
				reg = <0x07>;
				serdes-core = <0x00>;
				serdes-lane = <0x00>;
				status = "okay";
				phy-fixed;
				phy-reset = <0x0e 0x0e 0x00>;
				config-xfi = "10GBase-R";
				phandle = <0x16>;
			};

			phy_cascade1 {
				compatible = "brcm,bcaphy";
				phy-type = "EXT3";
				mphy-index = <0x00>;
				reg = <0x15>;
				status = "okay";
				phy-external;
				phandle = <0x0f>;
			};

			phy_cascade1_1 {
				compatible = "brcm,bcaphy";
				phy-type = "EXT3";
				mphy-index = <0x01>;
				reg = <0x0d>;
				status = "disabled";
				phy-external;
			};

			phy_cascade1_2 {
				compatible = "brcm,bcaphy";
				phy-type = "EXT3";
				mphy-index = <0x02>;
				reg = <0x0e>;
				status = "disabled";
				phy-external;
			};

			phy_cascade1_3 {
				compatible = "brcm,bcaphy";
				phy-type = "EXT3";
				mphy-index = <0x03>;
				reg = <0x0f>;
				status = "disabled";
				phy-external;
			};

			phy_serdes1 {
				compatible = "brcm,bcaphy";
				phy-type = "10GAE";
				reg = <0x08>;
				mphy-index = <0x00>;
				serdes-core = <0x01>;
				serdes-lane = <0x00>;
				status = "okay";
				phy-handle = <0x0f>;
				phandle = <0x17>;
			};

			phy_serdes1_1 {
				compatible = "brcm,bcaphy";
				phy-type = "10GAE";
				mphy-index = <0x01>;
				reg = <0x108>;
				serdes-core = <0x01>;
				serdes-lane = <0x00>;
				status = "disabled";
				phandle = <0x18>;
			};

			phy_serdes1_2 {
				compatible = "brcm,bcaphy";
				phy-type = "10GAE";
				mphy-index = <0x02>;
				reg = <0x208>;
				serdes-core = <0x01>;
				serdes-lane = <0x00>;
				status = "disabled";
				phandle = <0x19>;
			};

			phy_serdes1_3 {
				compatible = "brcm,bcaphy";
				phy-type = "10GAE";
				mphy-index = <0x03>;
				reg = <0x308>;
				serdes-core = <0x01>;
				serdes-lane = <0x00>;
				status = "disabled";
				phandle = <0x1a>;
			};
		};

		wan_serdes_bus {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			phy_wan_serdes {
				compatible = "brcm,bcaphy";
				phy-type = "PON";
				reg = <0x00>;
				status = "disabled";
				phandle = <0x1b>;
			};

			wan_ae {
				compatible = "brcm,bcaphy";
				phy-type = "AE";
				reg = <0x01>;
				status = "disabled";
				phandle = <0x14>;
			};
		};

		switch0 {
			compatible = "brcm,enet";
			label = "bcmsw";
			sw-type = "RUNNER_SW";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port_gphy0 {
					reg = <0x00>;
					mac-type = "UNIMAC";
					phy-handle = <0x10>;
					phy-mode = "gmii";
					gmii-direct;
					status = "disabled";
				};

				port_gphy1 {
					reg = <0x01>;
					mac-type = "UNIMAC";
					phy-handle = <0x11>;
					phy-mode = "gmii";
					gmii-direct;
					status = "okay";
					label = "eth2";
				};

				port_gphy2 {
					reg = <0x02>;
					mac-type = "UNIMAC";
					phy-handle = <0x12>;
					phy-mode = "gmii";
					gmii-direct;
					status = "disabled";
				};

				port_gphy3 {
					reg = <0x03>;
					mac-type = "UNIMAC";
					phy-handle = <0x13>;
					phy-mode = "gmii";
					gmii-direct;
					status = "disabled";
				};

				port_wan@ae {
					reg = <0x04>;
					mac-type = "XPORT";
					mac-index = <0x01>;
					phy-handle = <0x14>;
					phy-mode = "xfi";
					detect;
					is-wanconf-ae;
					status = "disabled";
				};

				port_xphy {
					reg = <0x05>;
					mac-type = "XPORT";
					mac-index = <0x00>;
					phy-handle = <0x15>;
					phy-mode = "serdes";
					status = "okay";
					label = "eth0";
				};

				port_sgmii1 {
					reg = <0x06>;
					mac-type = "XPORT";
					mac-index = <0x02>;
					phy-handle = <0x16>;
					phy-mode = "serdes";
					status = "okay";
					label = "eth1";
				};

				port_sgmii2 {
					reg = <0x07>;
					mac-type = "XPORT";
					mac-index = <0x04>;
					phy-handle = <0x17>;
					phy-mode = "serdes";
					status = "okay";
					label = "eth3";
				};

				port_sgmii2_1 {
					reg = <0x08>;
					mac-type = "XPORT";
					mac-index = <0x05>;
					phy-handle = <0x18>;
					phy-mode = "serdes";
					status = "disabled";
				};

				port_sgmii2_2 {
					reg = <0x09>;
					mac-type = "XPORT";
					mac-index = <0x06>;
					phy-handle = <0x19>;
					phy-mode = "serdes";
					status = "disabled";
				};

				port_sgmii2_3 {
					reg = <0x0a>;
					mac-type = "XPORT";
					mac-index = <0x07>;
					phy-handle = <0x1a>;
					phy-mode = "serdes";
					status = "disabled";
				};

				port_wan@fiber {
					reg = <0x0b>;
					phy-handle = <0x1b>;
					phy-mode = "serdes";
					detect;
					is-wan;
					is-wanconf-mux-pon;
					status = "disabled";
				};
			};
		};
	};

	ubus {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		ubus_sys {
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			compatible = "brcm,bca-ubus4";
			reg = <0x00 0x83000000 0x00 0x80 0x00 0x83000200 0x00 0x80 0x00 0x810a0400 0x00 0x400>;
			reg-names = "ubus_systop\0ubus_registration\0ubus_coherency_port";
			flags = <0x00>;

			ubus_mst {
				reg-names = "BIU\0PER\0USB\0SPU\0PCIE0\0PCIE1\0PCIE2\0PCIE3\0DMA0\0DMA1\0DMA2\0RQ0\0RQ1\0QM\0MPM";
				reg = <0x00 0x83020000 0x00 0x4000 0x00 0x83010000 0x00 0x4000 0x00 0x83018000 0x00 0x4000 0x00 0x83028000 0x00 0x4000 0x00 0x83030000 0x00 0x4000 0x00 0x83038000 0x00 0x4000 0x00 0x83040000 0x00 0x4000 0x00 0x83048000 0x00 0x4000 0x00 0x83058000 0x00 0x4000 0x00 0x83060000 0x00 0x4000 0x00 0x83070000 0x00 0x4000 0x00 0x83078000 0x00 0x4000 0x00 0x83080000 0x00 0x4000 0x00 0x83050000 0x00 0x4000 0x00 0x83088000 0x00 0x4000>;
			};
		};

		ubus_dcm_sys {
			compatible = "brcm,bca-ubus4-dcm";
			reg = <0x00 0x83000080 0x00 0x80>;
			reg-names = "ubus_dcm_clk";
			flags = <0x00>;
		};
	};

	periph {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges = <0x00 0x00 0x00 0xff800000 0x00 0x62000>;

		boot_state {
			u-boot,dm-pre-reloc;
			compatible = "brcm,bcmbca-bootstate-v2";
			reg = <0x00 0x2628 0x00 0x04 0x00 0x5a01c 0x00 0x04>;
			reg-names = "reset_reason\0reset_status";
		};

		nand {
			pinctrl-0 = <0x1c 0x1d 0x1e>;
			pinctrl-names = "default";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "brcm,nand-bcm63xx\0brcm,nand-bcmbca\0brcm,brcmnand-v7.1";
			reg = <0x00 0x1800 0x00 0x400 0x00 0x2000 0x00 0x10 0x00 0x1c00 0x00 0x200>;
			reg-names = "nand\0nand-int-base\0nand-cache";
			parameter-page-big-endian = <0x00>;
			write-protect = <0x01>;
			timing_1 = <0x320000>;
			timing_2 = <0x04>;
			status = "okay";

			nandcs@0 {
				compatible = "brcm,nandcs";
				reg = <0x00>;
				nand-on-flash-bbt;
			};
		};

		sdhci {
			pinctrl-0 = <0x1f>;
			pinctrl-names = "default";
			u-boot,dm-pre-reloc;
			compatible = "brcm,bcm63xx-sdhci";
			reg-names = "sdhci-base\0sdhci-topcfg\0sdhci-boot\0sdhci-ahbss-ctrl";
			reg = <0x00 0x10000 0x00 0x100 0x00 0x10100 0x00 0x100 0x00 0x10200 0x00 0x40 0x00 0x10300 0x00 0x100>;
			interrupts = <0x00 0x26 0x04>;
			bus-width = <0x08>;
			no-1-8-v;
			status = "okay";
			mmc-ddr-3_3v;
			sdhci-pll-baseclk-mhz = <0x1130>;
			sdhci-pll-valid-op-mhz = <0x64 0x6e 0xa0 0xb0 0xc8>;
		};

		rng {
			u-boot,dm-pre-reloc;
			compatible = "brcm,iproc-rng200";
			reg = <0x00 0xb80 0x00 0x30>;
		};

		trng {
			u-boot,dm-pre-reloc;
			compatible = "brcm,bcmbca-trng";
			reg = <0x00 0x3800 0x00 0x800>;
			status = "disabled";
		};

		strap {
			compatible = "brcm,strap";
			reg = <0x00 0x2600 0x00 0x04>;
			boot-select-0 = <0x00 0x01>;
			boot-select-1 = <0x01 0x01>;
			boot-select-2 = <0x02 0x01>;
			boot-select-3 = <0x03 0x01>;
			boot-select-4 = <0x04 0x01>;
			boot-select-5 = <0x05 0x01>;
			bootrom-boot = <0x0c 0x01>;
			strap-cpu-slow-freq = <0x10 0x01>;
			strap-vco-clock = <0x0d 0x02>;
		};

		otp {
			compatible = "brcm,otp";
			reg = <0x00 0x2800 0x00 0x64>;
